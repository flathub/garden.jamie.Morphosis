{
  "id": "garden.jamie.Morphosis",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "morphosis",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    "pandoc.json",
    "python3-weasyprint.json",
    {
      "name": "morphosis",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/World/morphosis.git",
          "tag": "49.0",
          "commit": "6b1d1833a5fb5507be0c05d0a26fee2a29223d20"
        }
      ]
    }
  ]
}
